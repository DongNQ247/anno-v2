{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "anno://schemas/label_verify.v1.json",
  "type": "object",
  "required": [
    "ok",
    "status",
    "image_path",
    "verification_id",
    "box"
  ],
  "properties": {
    "ok": {
      "const": true
    },
    "status": {
      "const": "success"
    },
    "image_path": {
      "type": "string"
    },
    "verification_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "box": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "integer"
      }
    }
  },
  "additionalProperties": false
}
