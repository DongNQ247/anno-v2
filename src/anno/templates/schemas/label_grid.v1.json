{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "anno://schemas/label_grid.v1.json",
  "type": "object",
  "required": [
    "ok",
    "status",
    "image_path",
    "artifact_path",
    "cell_labels",
    "cells",
    "image_size"
  ],
  "properties": {
    "ok": {
      "const": true
    },
    "status": {
      "const": "success"
    },
    "image_path": {
      "type": "string"
    },
    "artifact_path": {
      "type": "string"
    },
    "cell_labels": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cells": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "xyxy"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "xyxy": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "integer"
            }
          }
        }
      }
    },
    "image_size": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "integer"
      }
    },
    "crop": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4
    },
    "native_crop_size": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "render_size": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "scale": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "readable_labels": {
      "const": true
    },
    "subcell_size": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number",
        "exclusiveMinimum": 0
      }
    },
    "parent_cell_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    },
    "subcell_count": {
      "type": "integer",
      "minimum": 64,
      "maximum": 512
    },
    "recommended_max_parent_cells": {
      "const": 8
    }
  },
  "additionalProperties": false,
  "dependentRequired": {
    "crop": [
      "native_crop_size",
      "render_size",
      "scale",
      "readable_labels",
      "subcell_size",
      "parent_cell_count",
      "subcell_count",
      "recommended_max_parent_cells"
    ]
  }
}
