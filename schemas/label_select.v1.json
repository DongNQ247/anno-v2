{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "anno://schemas/label_select.v1.json",
  "type": "object",
  "required": [
    "ok",
    "status",
    "image_path",
    "artifact_path",
    "cell_labels",
    "cells",
    "image_size",
    "evidence_id",
    "coordinate_level",
    "parent_cells",
    "crop",
    "native_crop_size",
    "render_size",
    "scale",
    "readable_labels"
  ],
  "properties": {
    "ok": {
      "const": true
    },
    "status": {
      "const": "success"
    },
    "image_path": {
      "type": "string"
    },
    "artifact_path": {
      "type": "string"
    },
    "cell_labels": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cells": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "xyxy"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "xyxy": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "integer"
            }
          }
        }
      }
    },
    "image_size": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "integer"
      }
    },
    "evidence_id": {
      "type": "string"
    },
    "coordinate_level": {
      "type": "integer",
      "minimum": 1
    },
    "parent_cells": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "crop": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4
    },
    "native_crop_size": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "render_size": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "scale": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "readable_labels": {
      "const": true
    }
  },
  "additionalProperties": false
}
