{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "anno://schemas/label_select.v1.json",
  "type": "object",
  "required": [
    "ok",
    "status",
    "image_path",
    "artifact_path",
    "cell_labels",
    "crop"
  ],
  "properties": {
    "ok": {
      "const": true
    },
    "status": {
      "const": "success"
    },
    "image_path": {
      "type": "string"
    },
    "artifact_path": {
      "type": "string"
    },
    "cell_labels": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "crop": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4
    }
  },
  "additionalProperties": false
}
