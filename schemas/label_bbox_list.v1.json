{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "anno://schemas/label_bbox_list.v1.json",
  "type": "object",
  "required": [
    "ok",
    "status",
    "boxes"
  ],
  "properties": {
    "ok": {
      "const": true
    },
    "status": {
      "const": "success"
    },
    "boxes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "index",
          "class_id",
          "class_name",
          "xyxy"
        ]
      }
    }
  },
  "additionalProperties": false
}
