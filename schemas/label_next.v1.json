{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "anno://schemas/label_next.v1.json",
  "type": "object",
  "required": [
    "ok",
    "status",
    "image_path",
    "done",
    "task",
    "issues"
  ],
  "properties": {
    "ok": {
      "const": true
    },
    "status": {
      "const": "success"
    },
    "image_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "done": {
      "type": "boolean"
    },
    "task": {
      "enum": [
        "fix_issues",
        "new_label",
        null
      ]
    },
    "issues": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "done": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "image_path": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "image_path": {
            "type": "string"
          }
        }
      }
    }
  ]
}
