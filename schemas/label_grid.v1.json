{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "anno://schemas/label_grid.v1.json",
  "type": "object",
  "required": [
    "ok",
    "status",
    "image_path",
    "artifact_path",
    "cell_labels"
  ],
  "properties": {
    "ok": {
      "const": true
    },
    "status": {
      "const": "success"
    },
    "image_path": {
      "type": "string"
    },
    "artifact_path": {
      "type": "string"
    },
    "cell_labels": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cells": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "xyxy"],
        "properties": {
          "id": {"type": "string"},
          "xyxy": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "integer"}}
        }
      }
    },
    "image_size": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"type": "integer"}
    },
    "crop": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4
    }
  },
  "additionalProperties": false
}
