{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "anno://schemas/label_bbox_update.v1.json",
  "type": "object",
  "required": [
    "ok",
    "status",
    "image_path",
    "box_count",
    "written"
  ],
  "properties": {
    "ok": {
      "const": true
    },
    "status": {
      "const": "success"
    },
    "image_path": {
      "type": "string"
    },
    "label_path": {
      "type": "string"
    },
    "box_count": {
      "type": "integer",
      "minimum": 0
    },
    "written": {
      "const": true
    },
    "box": {
      "type": "object",
      "required": ["index", "class_id", "class_name", "xyxy"],
      "properties": {
        "index": {"type": "integer", "minimum": 0},
        "class_id": {"type": "integer", "minimum": 0},
        "class_name": {"type": "string"},
        "xyxy": {"type": "array", "minItems": 4, "maxItems": 4}
      }
    }
  },
  "additionalProperties": false
}
